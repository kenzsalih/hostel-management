# MongoDB Connection (Local)
# For local development:
MONGO_URI=mongodb://localhost:27017/hostel-mess

# For MongoDB Atlas (cloud) - uncomment and replace when ready:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/hostel-mess

# JWT Secret Key (change this in production!)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Comma-separated explicit origins for frontend access
CORS_ORIGIN=http://localhost:3000

# Allow mess secretary to create only student users
ALLOW_MESS_SECRETARY_USER_CREATION=false

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development
